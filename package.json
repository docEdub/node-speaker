    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/mastra-ai/node-speaker"
    },
    "main": "index.js",
    "types": "index.d.ts",
    "scripts": {
        "build:coreaudio": "node-gyp build --mpg123-backend=coreaudio",
